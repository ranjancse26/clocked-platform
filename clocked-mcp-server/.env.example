# Required: Clocked API bearer token
CLOCKED_API_KEY=replace-with-your-clocked-api-key

# HTTP server settings
HOST=127.0.0.1
PORT=3001

# Clocked API base URL (override for self-hosted or regional instances)
CLOCKED_BASE_URL=https://clocked.rezolve.ai

# Clocked API request timeout in milliseconds
CLOCKED_TIMEOUT_MS=60000

# Optional shared secret protecting the MCP endpoint.
# If set, clients must send: Authorization: Bearer <MCP_ACCESS_TOKEN>
# Use a different secret from CLOCKED_API_KEY.
MCP_ACCESS_TOKEN=

# Maximum JSON request body size
JSON_BODY_LIMIT=2mb
# Start in demo mode without external credentials. Set false to use live APIs.
DEMO_MODE="true"

# Required when DEMO_MODE=false
UNSTRUCTURED_API_KEY="replace-with-your-clocked-api-key"
UNSTRUCTURED_PARSE_URL="https://transform.unstructured.io/api/v2/parse"

# Set these to the exact endpoints for your Clocked account/API version.
CLOCKED_API_KEY="replace-with-your-clocked-api-key"
CLOCKED_EXTRACT_URL="https://clocked.rezolve.ai/clocked/extract"
CLOCKED_DECIDE_URL="https://clocked.rezolve.ai/clocked/decide"
CLOCKED_INJECTION_URL="https://clocked.rezolve.ai/clocked/injection"

# PostgreSQL for persistent invoice history
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/clocked_invoice?schema=public"

# Local MVP file storage directory (keep private; do not serve this directory statically)
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB="10"

# Clerk
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/login
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="replace-with-your-clocked-api-key"
CLERK_SECRET_KEY="replace-with-your-clocked-api-key"
